PORT=5000
NODE_ENV=development

# PostgreSQL Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mazza_food_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# JWT Configuration
JWT_SECRET=mazza_super_secret_jwt_key_change_in_production_2026
JWT_ADMIN_SECRET=mazza_admin_secret_jwt_key_change_in_production_2026
JWT_EXPIRES_IN=7d
JWT_ADMIN_EXPIRES_IN=24h

# Security
BCRYPT_SALT_ROUNDS=10

# CORS / Frontend URL
FRONTEND_URL=http://localhost:5000

# Delivery settings (UZS)
DELIVERY_FEE=15000
FREE_DELIVERY_THRESHOLD=100000
